# ========== 复制本文件为 .env，并填入真实值 ==========
# 配置项名对应 app/config.py 的 Settings 字段（大写蛇形），支持环境变量覆盖。

# ---------- 千问（Qwen）大模型，OpenAI 兼容端点，主模型 ----------
QIANWEN_API_KEY=请填入你的千问 API Key
QIANWEN_MODEL_NAME=qwen3.7-plus
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- DeepSeek（备用，默认不启用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- MongoDB（会话 / 消息持久化） ----------
MONGODB_URI=mongodb://localhost:27017/ai

# ---------- Redis（chat memory 持久化） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- Qdrant（向量库，走 HTTP REST 接口，默认 6333） ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=bge-small-zh-v1.5
QDRANT_MIN_SCORE=0.7
QDRANT_MAX_RESULTS=5

# ---------- 向量模型（bge-small-zh，HuggingFaceEmbeddings 加载） ----------
# 可填 HuggingFace 模型 ID（首次会自动下载），或本地已下载的模型目录路径
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5

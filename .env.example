# ========== 复制本文件为 .env，并填入真实值 ==========
# 配置项名对应 app/config.py 的 Settings 字段（大写蛇形），支持环境变量覆盖。

# ---------- 千问（Qwen）大模型，OpenAI 兼容端点，主模型 ----------
QIANWEN_API_KEY=请填入你的千问 API Key
QIANWEN_MODEL_NAME=qwen3.7-plus
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- DeepSeek（备用，默认不启用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- MongoDB（会话 / 消息持久化） ----------
MONGODB_URI=mongodb://localhost:27017/ai

# ---------- Redis（chat memory 持久化） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- Qdrant（向量库） ----------
# 走 HTTP REST 接口（默认 6333），gRPC(6334) 与 Qdrant 1.16 存在兼容问题
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_TLS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=bge_small_zh_512
QDRANT_MIN_SCORE=0.7
QDRANT_MAX_RESULTS=5

# ---------- 本地 ONNX 向量模型 ----------
# 模型文件较大不纳入仓库，请按 resources/onnx/bge-small-zh/README.md 放置，
# 并在此填写实际路径（推荐放到项目目录之外，避免 IDE 索引大文件）
EMBEDDING_MODEL_PATH=resources/onnx/bge-small-zh/bge-small-zh-v1.5.onnx
EMBEDDING_TOKENIZER_PATH=resources/onnx/bge-small-zh/bge-small-zh-v1.5-tokenizer.json
EMBEDDING_POOLING_MODE=CLS
